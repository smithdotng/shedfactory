<%
  const title = "UI/UX Design";
  const description = "Shedfactory creates intuitive, beautiful interfaces that engage users and drive conversions through thoughtful user experience design.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-services.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li><a href="/services">Services</a></li>
                <li><span>/</span></li>
                <li>UI/UX Design</li>
            </ul>
            <h2>UI/UX Design</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Service Details Start -->
<section class="service-details">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="service-details__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Design That Delights and Converts</span>
                        <h2 class="section-title__title">Crafting Seamless Digital Experiences</h2>
                    </div>
                    <p class="service-details__text">Great design is invisible—it guides users effortlessly toward their goals while making every interaction feel natural and enjoyable. Our UI/UX design service bridges the gap between your brand and your audience, creating interfaces that are not only beautiful but also highly functional and intuitive.</p>
                    <p class="service-details__text">We begin by understanding your users—their needs, behaviors, and pain points—through research and testing. Then we design wireframes, prototypes, and high‑fidelity visuals that align with your brand and drive engagement. Whether it’s a website, mobile app, or complex dashboard, we ensure every touchpoint is a pleasure to use.</p>
                    <div class="service-details__points-box">
                        <ul class="list-unstyled service-details__points">
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>User Research & Personas</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Wireframing & Prototyping</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Visual Design & Interaction</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Usability Testing & Iteration</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <a href="/contact" class="thm-btn service-details__btn">Start Your Design Journey</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="service-details__right">
                    <div class="service-details__img">
                        <img src="/assets/images/services/ui-ux.jpg" alt="UI/UX Design">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service Details End -->

<!-- Process Start -->
<section class="process-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Our Approach</span>
            <h2 class="section-title__title">How We Design for People</h2>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                <div class="process-one__single">
                    <div class="process-one__count">01</div>
                    <div class="process-one__content">
                        <h3>Empathise & Research</h3>
                        <p>We conduct user interviews, surveys, and competitor analysis to understand real needs.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="process-one__single">
                    <div class="process-one__count">02</div>
                    <div class="process-one__content">
                        <h3>Define & Structure</h3>
                        <p>We create user flows, sitemaps, and wireframes to map out the ideal experience.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                <div class="process-one__single">
                    <div class="process-one__count">03</div>
                    <div class="process-one__content">
                        <h3>Design & Prototype</h3>
                        <p>We craft high‑fidelity visuals and interactive prototypes for testing.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                <div class="process-one__single">
                    <div class="process-one__count">04</div>
                    <div class="process-one__content">
                        <h3>Test & Iterate</h3>
                        <p>We validate designs with real users and refine until it’s perfect.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process End -->

<!-- Why It Matters Start -->
<section class="we-shape" style="margin-top: 0;">
    <div class="we-shape-bg" style="background-image: url(/assets/images/backgrounds/why-choose-us.jpg)"></div>
    <div class="container">
        <div class="we-shape__top">
            <div class="row">
                <div class="col-xl-7">
                    <div class="we-shape__top-title">
                        <h2>Why Great UI/UX Matters</h2>
                        <a href="/contact" class="we-shape__top-btn thm-btn">Let’s Talk</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="we-shape__bottom">
            <div class="row">
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="300ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-engagement"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Higher Engagement</h4>
                            <p>Intuitive interfaces keep users on your site longer and reduce bounce rates.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="600ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-trust"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Builds Trust</h4>
                            <p>Professional, consistent design signals credibility and reliability.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="900ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-roi"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Boosts Conversions</h4>
                            <p>Well‑designed user flows guide visitors to take desired actions.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Why It Matters End -->

<!-- Testimonial Start -->
<section class="inspire about-page-inspire">
    <div class="inspire__container">
        <div class="inspire-bg jarallax" data-jarallax data-speed="0.2" data-imgPosition="50% 0%"
            style="background-image: url(/assets/images/backgrounds/testimonials-bg.jpg)"></div>
        <div class="inspire-bg-overly"></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="inspire__left">
                        <div class="inspire__carousel owl-theme owl-carousel">
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"The website Shedfactory created for Savoy Summerset Hotel perfectly captures the elegance and luxury of our property. It's visually stunning and has received wonderful feedback from our guests."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Lanre, Manager</h4>
                                    <p class="inspire__clinet-title">Savoy Summerset Hotel</p>
                                </div>
                            </div>
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory built us a website and booking engine that transformed how we manage reservations. The system is intuitive, seamless, and has significantly increased our direct bookings."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Chike Okoroafor</h4>
                                    <p class="inspire__clinet-title">Full Moon Hotels</p>
                                </div>
                            </div>
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory didn't just create our brand identity and website—they built us a complete recruitment portal that streamlines our hiring process. Their attention to detail and technical expertise made all the difference."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Maureen, CEO</h4>
                                    <p class="inspire__clinet-title">Serinity Healthkare</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Testimonial End -->

<!-- CTA Start -->
<section class="cta-one">
    <div class="container">
        <div class="cta-one__inner">
            <div class="cta-one__left">
                <h2 class="cta-one__title">Ready to create an exceptional user experience?</h2>
                <p class="cta-one__subtitle">Let’s design something your users will love.</p>
            </div>
            <div class="cta-one__button">
                <a href="/contact" class="thm-btn cta-one__btn">Start Your Project</a>
            </div>
        </div>
    </div>
</section>
<!-- CTA End -->

<%- include('partials/footer') %>