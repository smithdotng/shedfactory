<%
  const title = "Our Services";
  const description = "Shedfactory offers brand strategy, web development, digital marketing, UI/UX design, and content creation to bring your dreams to life.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-service.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li>Services</li>
            </ul>
            <h2>Our Services</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Services Three Start -->
<section class="services-one services-three">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">What We Do</span>
            <h2 class="section-title__title">How We Bring Dreams to Life</h2>
        </div>
        <ul class="services-one__box list-unstyled clearfix">
            <li class="services-one__single wow fadeInUp" data-wow-delay="100ms">
                <div class="services-one__icon">
                    <span class="icon-strategy"></span>
                </div>
                <h3 class="services-one__title">
                    <a href="/brand-strategy">Brand Strategy & Identity</a>
                </h3>
                <p class="services-one__text">Developing compelling brand narratives and visual identities that connect with your audience and differentiate you in the marketplace.</p>
            </li>
            <li class="services-one__single wow fadeInUp" data-wow-delay="200ms">
                <div class="services-one__icon">
                    <span class="icon-web-development"></span>
                </div>
                <h3 class="services-one__title">
                    <a href="/web-development">Web & App Development</a>
                </h3>
                <p class="services-one__text">Custom websites and applications built with cutting-edge technologies, optimized for performance and exceptional user experience.</p>
            </li>
            <li class="services-one__single wow fadeInUp" data-wow-delay="300ms">
                <div class="services-one__icon">
                    <span class="icon-ui-ux"></span>
                </div>
                <h3 class="services-one__title">
                    <a href="/ui-ux">UI/UX Design</a>
                </h3>
                <p class="services-one__text">Creating intuitive, beautiful interfaces that engage users and drive conversions through thoughtful user experience design.</p>
            </li>
            <li class="services-one__single wow fadeInUp" data-wow-delay="400ms">
                <div class="services-one__icon">
                    <span class="icon-digital-marketing"></span>
                </div>
                <h3 class="services-one__title">
                    <a href="/digital-marketing">Digital Marketing</a>
                </h3>
                <p class="services-one__text">Data-driven marketing strategies that increase visibility, drive engagement, and convert visitors into loyal customers.</p>
            </li>
            <li class="services-one__single wow fadeInUp" data-wow-delay="500ms">
                <div class="services-one__icon">
                    <span class="icon-content-creation"></span>
                </div>
                <h3 class="services-one__title">
                    <a href="/content">Content Creation</a>
                </h3>
                <p class="services-one__text">Compelling content that tells your story, engages your audience, and establishes your brand as an industry authority.</p>
            </li>
        </ul>
    </div>
</section>
<!-- Services Three End -->

<!-- The Only Start (Why Experience Matters) -->
<section class="the-only services-page-the-only">
    <div class="the-only-bg" style="background-image: url(/assets/images/backgrounds/the-only-bg.jpg)"></div>
    <div class="container">
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="the-only__knowledge">
                    <h3>The Only Source of Knowledge is Experience</h3>
