                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="the-only__text-box">
                    <p>For 10 years, we've partnered with visionary businesses to turn dreams into digital reality. Our experience spans 25+ industries and 100+ successful projects.</p>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="the-only__points-box">
                    <ul class="list-unstyled the-only__points">
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>10 years of excellence</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>100+ dreams realized</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>25+ industries served</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>98% client satisfaction</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- The Only End -->

