    <!-- Custom Script for Mobile Menu, Search Toggle & Newsletter AJAX -->
    <style>
        /* Mobile search form styling */
        .mobile-search-form {
            padding: 15px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .mobile-search {
            display: flex;
            background: rgba(255,255,255,0.1);
            border-radius: 30px;
            overflow: hidden;
        }
        .mobile-search input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 10px 15px;
            color: #fff;
            font-size: 14px;
        }
        .mobile-search input::placeholder {
            color: rgba(255,255,255,0.6);
        }
        .mobile-search button {
            background: transparent;
            border: none;
            padding: 0 15px;
            color: #fff;
            cursor: pointer;
            transition: color 0.3s;
        }
        .mobile-search button:hover {
            color: #fe1f07;
        }
    </style>
    <script>
        (function() {
            'use strict';

            // ----- Mobile Menu Toggle -----
            document.addEventListener('DOMContentLoaded', function() {
                const togglers = document.querySelectorAll('.mobile-nav__toggler');
                const mobileNav = document.querySelector('.mobile-nav__wrapper');
                
                if (mobileNav && togglers.length) {
                    // Function to open/close mobile nav
                    const toggleMobileNav = (e) => {
                        if (e) e.preventDefault();
                        mobileNav.classList.toggle('active');
                    };

                    // Add click event to all togglers (header hamburger and close button)
                    togglers.forEach(toggler => {
                        toggler.addEventListener('click', toggleMobileNav);
                    });

                    // Close when clicking overlay (already a toggler, but ensure it's covered)
                    const overlay = mobileNav.querySelector('.mobile-nav__overlay');
                    if (overlay) {
                        overlay.addEventListener('click', toggleMobileNav);
                    }

                    // Prevent clicks inside content from closing
                    const content = mobileNav.querySelector('.mobile-nav__content');
                    if (content) {
                        content.addEventListener('click', (e) => e.stopPropagation());
                    }
                }

                // ----- Search Popup Toggle (for desktop) -----
                const searchTogglers = document.querySelectorAll('.search-toggler');
                const searchPopup = document.querySelector('.search-popup');
                
                if (searchPopup && searchTogglers.length) {
                    const toggleSearch = (e) => {
                        e.preventDefault();
                        searchPopup.classList.toggle('active');
                    };

                    searchTogglers.forEach(toggler => {
                        toggler.addEventListener('click', toggleSearch);
                    });

                    const overlay = searchPopup.querySelector('.search-popup__overlay');
                    if (overlay) {
                        overlay.addEventListener('click', toggleSearch);
                    }

                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape' && searchPopup.classList.contains('active')) {
                            searchPopup.classList.remove('active');
                        }
                    });
                }

                // ----- Newsletter AJAX -----
                const form = document.getElementById('newsletter-form');
                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        const email = form.email.value.trim();
                        const messageDiv = form.querySelector('.newsletter-message');

                        // Basic email validation
                        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                            messageDiv.innerHTML = '<span style="color: #fe1f07;">Please enter a valid email address.</span>';
                            return;
                        }

                        messageDiv.innerHTML = '';

                        try {
                            const response = await fetch('/newsletter', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify({ email })
                            });

                            const data = await response.json();

                            if (data.success) {
                                messageDiv.innerHTML = '<span style="color: #28a745;">' + data.message + '</span>';
                                form.reset();
                            } else {
                                messageDiv.innerHTML = '<span style="color: #fe1f07;">' + data.message + '</span>';
                            }
                        } catch (error) {
                            messageDiv.innerHTML = '<span style="color: #fe1f07;">An error occurred. Please try again later.</span>';
                            console.error('Newsletter error:', error);
                        }
                    });
                }
            });
        })();
    </script>
