    <!-- Newsletter AJAX Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('newsletter-form');
            if (!form) return;

            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const email = form.email.value.trim();
                const messageDiv = form.querySelector('.newsletter-message');

                // Basic validation
                if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    messageDiv.innerHTML = '<span style="color: #fe1f07;">Please enter a valid email address.</span>';
                    return;
                }

                // Clear previous message
                messageDiv.innerHTML = '';

                try {
                    const response = await fetch('/newsletter', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ email })
                    });

                    const data = await response.json();

                    if (data.success) {
                        messageDiv.innerHTML = '<span style="color: #28a745;">' + data.message + '</span>';
                        form.reset(); // Clear the input
                    } else {
                        messageDiv.innerHTML = '<span style="color: #fe1f07;">' + data.message + '</span>';
                    }
                } catch (error) {
                    messageDiv.innerHTML = '<span style="color: #fe1f07;">An error occurred. Please try again later.</span>';
                    console.error('Newsletter error:', error);
                }
            });
        });
    </script>

