<%
  const title = "Brand Strategy & Identity";
  const description = "Shedfactory's brand strategy services help you define your unique voice, connect with your audience, and stand out in the marketplace.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-service.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li><a href="/services">Services</a></li>
                <li><span>/</span></li>
                <li>Brand Strategy & Identity</li>
            </ul>
            <h2>Brand Strategy & Identity</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Service Details Start -->
<section class="service-details">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="service-details__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Define Your Unique Voice</span>
                        <h2 class="section-title__title">Bring Your Brand’s Dream to Life</h2>
                    </div>
                    <p class="service-details__text">Your brand is more than a logo—it’s the story you tell, the emotions you evoke, and the promise you make to your customers. Our brand strategy and identity service helps you craft a compelling narrative and a visual identity that resonates deeply with your audience.</p>
                    <p class="service-details__text">We work closely with you to uncover your core values, understand your market, and define your unique positioning. From there, we build a cohesive brand system—logos, color palettes, typography, messaging, and guidelines—that sets you apart and builds lasting trust.</p>
                    <div class="service-details__points-box">
                        <ul class="list-unstyled service-details__points">
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Brand Discovery & Positioning</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Visual Identity Design (Logo, Colors, Typography)</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Brand Messaging & Tone of Voice</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Brand Guidelines & Asset Creation</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <a href="/contact" class="thm-btn service-details__btn">Start Your Brand Journey</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="service-details__right">
                    <div class="service-details__img">
                        <img src="/assets/images/services/brand-strategy.jpg" alt="Brand Strategy">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service Details End -->

<!-- Process Start -->
<section class="process-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Our Approach</span>
            <h2 class="section-title__title">How We Build Your Brand</h2>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                <div class="process-one__single">
                    <div class="process-one__count">01</div>
                    <div class="process-one__content">
                        <h3>Discovery</h3>
                        <p>We dive deep into your vision, values, and market through workshops and research.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="process-one__single">
                    <div class="process-one__count">02</div>
                    <div class="process-one__content">
                        <h3>Strategy</h3>
                        <p>We define your positioning, messaging, and brand architecture.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                <div class="process-one__single">
                    <div class="process-one__count">03</div>
                    <div class="process-one__content">
                        <h3>Design</h3>
                        <p>We craft your visual identity—logo, colors, typography, and all brand assets.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                <div class="process-one__single">
                    <div class="process-one__count">04</div>
                    <div class="process-one__content">
                        <h3>Launch & Evolve</h3>
                        <p>We roll out your brand and provide guidelines for consistent growth.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process End -->

<!-- Why It Matters Start -->
<section class="we-shape" style="margin-top: 0;">
    <div class="we-shape-bg" style="background-image: url(/assets/images/backgrounds/why-choose-us.jpg)"></div>
    <div class="container">
        <div class="we-shape__top">
            <div class="row">
                <div class="col-xl-7">
                    <div class="we-shape__top-title">
                        <h2>Why Brand Strategy Matters</h2>
                        <a href="/contact" class="we-shape__top-btn thm-btn">Let’s Talk</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="we-shape__bottom">
            <div class="row">
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="300ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-standout"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Stand Out</h4>
                            <p>In a crowded market, a strong brand differentiates you and makes you memorable.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="600ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-trust"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Build Trust</h4>
                            <p>Consistent, authentic branding fosters credibility and loyalty with your audience.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="900ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-growth"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Drive Growth</h4>
                            <p>A well-defined brand attracts the right customers and supports premium pricing.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Why It Matters End -->

<!-- Testimonial Start -->
<section class="inspire about-page-inspire">
    <div class="inspire__container">
        <div class="inspire-bg jarallax" data-jarallax data-speed="0.2" data-imgPosition="50% 0%"
            style="background-image: url(/assets/images/backgrounds/testimonials-bg.jpg)"></div>
        <div class="inspire-bg-overly"></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="inspire__left">
                        <div class="inspire__carousel owl-theme owl-carousel">
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory didn't just create our brand identity—they captured the soul of our business. Our new brand has transformed how clients perceive us."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Maureen, CEO</h4>
                                    <p class="inspire__clinet-title">Serinity Healthkare</p>
                                </div>
                            </div>
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"The brand strategy Shedfactory developed gave us a clear direction and a visual identity that truly reflects our values. It’s been a game-changer."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Chike Okoroafor</h4>
                                    <p class="inspire__clinet-title">Full Moon Hotels</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Testimonial End -->

<!-- CTA Start -->
<section class="cta-one">
    <div class="container">
        <div class="cta-one__inner">
            <div class="cta-one__left">
                <h2 class="cta-one__title">Ready to define your brand’s dream?</h2>
                <p class="cta-one__subtitle">Let’s create a brand that truly represents you.</p>
            </div>
            <div class="cta-one__button">
                <a href="/contact" class="thm-btn cta-one__btn">Start Your Project</a>
            </div>
        </div>
    </div>
</section>
<!-- CTA End -->

<%- include('partials/footer') %>