<%
  const title = "About Us";
  const description = "Shedfactory is a digital creative agency bringing dreams to life through brand strategy, web development, and digital marketing. Learn our story.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-about.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li>About</li>
            </ul>
            <h2>About Shedfactory</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Grow And Experience Start (Main About Content) -->
<section class="grow-and-experience-two">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="grow-and-experience-two__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Our Story</span>
                        <h2 class="section-title__title">Bringing Dreams to Digital Life for 10 Years</h2>
                    </div>
                    <p class="grow-and-experience-two__text">
                        Shedfactory was founded on a simple belief: every great business starts with a dream, but dreams need the right partner to become reality. For a decade, we've been that partner—bridging the gap between visionary ideas and exceptional digital experiences.
                    </p>
                    <p class="grow-and-experience-two__text">
                        While our clients bring the passion and vision, we bring the creative and technical expertise to transform abstract concepts into compelling brands, engaging websites, powerful web applications, and results-driven digital marketing strategies. We don't just execute tasks; we amplify dreams.
                    </p>
                    <ul class="list-unstyled grow-and-experience-two__list">
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>10 years of creative excellence</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>100+ dreams brought to life</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>25+ industries transformed</p>
                            </div>
                        </li>
                        <li>
                            <div class="icon">
                                <i class="fa fa-check"></i>
                            </div>
                            <div class="text">
                                <p>Partnership approach, not just projects</p>
                            </div>
                        </li>
                    </ul>
                    <a href="/contact" class="grow-and-experience-two__btn thm-btn">Start Your Dream Project</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="grow-and-experience-two__right">
                    <ul class="list-unstyled grow-and-experience-two__images">
                        <li>
                            <div class="grow-and-experience-two__img-1">
                                <img src="/assets/images/resources/grow-and-experience-img-1.jpg" alt="Shedfactory creative process">
                            </div>
                        </li>
                        <li>
                            <div class="grow-and-experience-two__img-2">
                                <img src="/assets/images/resources/grow-and-experience-img-2.jpg" alt="Shedfactory team collaboration">
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Grow And Experience End -->

<!-- Brand One Start (Trusted By) -->
<section class="brand-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Trusted By</span>
            <h2 class="section-title__title">Visionary Brands We've Partnered With</h2>
        </div>
        <div class="brand-one__inner">
            <div class="thm-swiper__slider swiper-container" data-swiper-options='{"spaceBetween": 100, "slidesPerView": 5, "autoplay": { "delay": 5000 }, "breakpoints": {
                "0": {
                    "spaceBetween": 30,
                    "slidesPerView": 2
                },
                "375": {
                    "spaceBetween": 30,
                    "slidesPerView": 2
                },
                "575": {
                    "spaceBetween": 30,
                    "slidesPerView": 3
                },
                "767": {
                    "spaceBetween": 50,
                    "slidesPerView": 4
                },
                "991": {
                    "spaceBetween": 50,
                    "slidesPerView": 5
                },
                "1199": {
                    "spaceBetween": 100,
                    "slidesPerView": 5
                }
            }}'>
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <img src="/assets/images/brand/brand-1-1.png" alt="Full Moon Hotels">
                    </div>
                    <div class="swiper-slide">
                        <img src="/assets/images/brand/brand-1-2.png" alt="Savoy Summerset Hotel">
                    </div>
                    <div class="swiper-slide">
                        <img src="/assets/images/brand/brand-1-3.png" alt="Serinity Healthkare">
                    </div>
                    <div class="swiper-slide">
                        <img src="/assets/images/brand/brand-1-4.png" alt="Radiant Life Day Centre">
                    </div>
                    <div class="swiper-slide">
                        <img src="/assets/images/brand/brand-1-5.png" alt="SA Facilities">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Brand One End -->

<!-- Discover World Two Start (Video CTA) -->
<section class="discover-world-two about-page-discover-world-two">
    <div class="discover-world-two-bg jarallax" data-jarallax data-speed="0.2" data-imgPosition="50% 0%"
        style="background-image: url(/assets/images/backgrounds/discover-world-two-bg.jpg)"></div>
    <div class="discover-world-two__inner">
        <h2 class="discover-world__title">Discover How We Bring <br> Dreams to Life</h2>
        <div class="discover-world__video-link">
            <!-- Replaced YouTube link with local video file -->
                <a href="/assets/videos/vid1.mp4" class="video-popup">
                <div class="discover-world__video-icon">
                    <span class="icon-play-button"></span>
                    <i class="ripple"></i>
                </div>
            </a>
        </div>
    </div>
</section>
<!-- Discover World Two End -->

<!-- Inspire Start (Testimonials & Stats) -->
<section class="inspire about-page-inspire">
    <div class="inspire__container">
        <div class="inspire-bg jarallax" data-jarallax data-speed="0.2" data-imgPosition="50% 0%"
            style="background-image: url(/assets/images/backgrounds/inspire-bg.jpg)"></div>
        <div class="inspire-bg-overly"></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-8 col-lg-8">
                    <div class="inspire__left">
                        <div class="inspire__carousel owl-theme owl-carousel">
                            <!-- Testimonial 1: Chike Okoroafor -->
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory built us a website and booking engine that transformed how we manage reservations. The system is intuitive, seamless, and has significantly increased our direct bookings. They truly understood our vision for Full Moon Hotels and delivered beyond expectations."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Chike Okoroafor</h4>
                                    <p class="inspire__clinet-title">Full Moon Hotels</p>
                                </div>
                            </div>
                            <!-- Testimonial 2: Lanre, Savoy Summerset Hotel -->
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"The website Shedfactory created for Savoy Summerset Hotel perfectly captures the elegance and luxury of our property. It's visually stunning, easy to navigate, and has received wonderful feedback from our guests. A pleasure working with such a talented team."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Lanre, Manager</h4>
                                    <p class="inspire__clinet-title"><a href="https://savoysummerset.com" target="_blank">Savoy Summerset Hotel</a></p>
                                </div>
                            </div>
                            <!-- Testimonial 3: Maureen, Serinity Healthkare -->
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory didn't just create our brand identity and website—they built us a complete recruitment portal that streamlines our hiring process. Their attention to detail and strategic approach to our digital presence has been instrumental in Serinity Healthkare's growth."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Maureen, CEO</h4>
                                    <p class="inspire__clinet-title"><a href="https://serinityhealthkare.co.uk" target="_blank">Serinity Healthkare</a></p>
                                </div>
                            </div>
                            <!-- Testimonial 4: Ifedi, Radiant Life Day Centre -->
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory has been instrumental in our digital journey. They developed our website and manage our social media with exceptional strategic communication. Our online presence has grown significantly, and they've helped us connect with our community in meaningful ways."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Ifedi</h4>
                                    <p class="inspire__clinet-title"><a href="https://radiantlifedaycentre.co.uk" target="_blank">Radiant Life Day Centre</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4">
                    <div class="inspire__right">
                        <ul class="list-unstyled inspire__counter">
                            <li class="wow fadeInLeft" data-wow-delay="300ms">
                                <div class="inspire__icon">
                                    <span class="icon-clock"></span>
                                </div>
                                <div class="inspire__content">
                                    <h2 class="odometer" data-count="10">00</h2>
                                    <p>Years of Bringing Dreams to Life</p>
                                </div>
                            </li>
                            <li class="wow fadeInLeft" data-wow-delay="600ms">
                                <div class="inspire__icon">
                                    <span class="icon-heart"></span>
                                </div>
                                <div class="inspire__content">
                                    <h2 class="odometer" data-count="100">00</h2>
                                    <p>% Passion in Every Project</p>
                                </div>
                            </li>
                            <li class="wow fadeInLeft" data-wow-delay="900ms">
                                <div class="inspire__icon">
                                    <span class="icon-handshake"></span>
                                </div>
                                <div class="inspire__content">
                                    <h2 class="odometer" data-count="25">00</h2>
                                    <p>+ Industries Transformed</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Inspire End -->

<!-- CTA One Start -->
<section class="cta-one">
    <div class="container">
        <div class="cta-one__inner">
            <div class="cta-one__left">
                <h2 class="cta-one__title">Ready to Bring Your Dream to Life?</h2>
                <p class="cta-one__subtitle">Let's create something amazing together.</p>
            </div>
            <div class="cta-one__button">
                <a href="/contact" class="thm-btn cta-one__btn">Start Your Project</a>
            </div>
        </div>
    </div>
</section>
<!-- CTA One End -->

<%- include('partials/footer') %>