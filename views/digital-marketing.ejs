<%
  const title = "Digital Marketing";
  const description = "Shedfactory's digital marketing services help you reach your audience, drive engagement, and grow your business through data-driven strategies.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-service.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li><a href="/services">Services</a></li>
                <li><span>/</span></li>
                <li>Digital Marketing</li>
            </ul>
            <h2>Digital Marketing</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Service Details Start -->
<section class="service-details">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="service-details__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Grow Your Audience, Amplify Your Impact</span>
                        <h2 class="section-title__title">Connect With the Right People at the Right Time</h2>
                    </div>
                    <p class="service-details__text">A beautiful website or a strong brand is only half the story. To truly bring your dream to life, you need to be found, heard, and remembered. Our digital marketing strategies are designed to increase your visibility, engage your target audience, and turn visitors into loyal customers.</p>
                    <p class="service-details__text">We take a data‑driven approach, combining creativity with analytics to deliver measurable results. Whether it's SEO, social media, content marketing, or paid advertising, we craft campaigns that align with your goals and resonate with your community.</p>
                    <div class="service-details__points-box">
                        <ul class="list-unstyled service-details__points">
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Search Engine Optimization (SEO)</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Social Media Strategy & Management</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Content Marketing & Copywriting</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Paid Advertising (Google, Social, Display)</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <a href="/contact" class="thm-btn service-details__btn">Grow Your Reach</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="service-details__right">
                    <div class="service-details__img">
                        <img src="/assets/images/services/digital-marketing.jpg" alt="Digital Marketing">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service Details End -->

<!-- Process Start -->
<section class="process-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Our Approach</span>
            <h2 class="section-title__title">How We Drive Your Growth</h2>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                <div class="process-one__single">
                    <div class="process-one__count">01</div>
                    <div class="process-one__content">
                        <h3>Research & Strategy</h3>
                        <p>We analyse your market, competitors, and audience to build a tailored plan.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="process-one__single">
                    <div class="process-one__count">02</div>
                    <div class="process-one__content">
                        <h3>Content & Campaign Creation</h3>
                        <p>We develop compelling content and campaigns that capture attention.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                <div class="process-one__single">
                    <div class="process-one__count">03</div>
                    <div class="process-one__content">
                        <h3>Execution & Management</h3>
                        <p>We launch and manage your campaigns across the right channels.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                <div class="process-one__single">
                    <div class="process-one__count">04</div>
                    <div class="process-one__content">
                        <h3>Analysis & Optimisation</h3>
                        <p>We track performance and continuously refine for better results.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process End -->

<!-- Why It Matters Start -->
<section class="we-shape" style="margin-top: 0;">
    <div class="we-shape-bg" style="background-image: url(/assets/images/backgrounds/why-choose-us.jpg)"></div>
    <div class="container">
        <div class="we-shape__top">
            <div class="row">
                <div class="col-xl-7">
                    <div class="we-shape__top-title">
                        <h2>Why Digital Marketing Matters</h2>
                        <a href="/contact" class="we-shape__top-btn thm-btn">Let’s Talk</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="we-shape__bottom">
            <div class="row">
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="300ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-visibility"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Increase Visibility</h4>
                            <p>Be found by the people actively searching for what you offer.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="600ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-engagement"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Build Relationships</h4>
                            <p>Engage with your audience and build a community around your brand.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="900ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-roi"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Maximise ROI</h4>
                            <p>Targeted campaigns deliver higher returns and lower acquisition costs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Why It Matters End -->

<!-- Testimonial Start -->
