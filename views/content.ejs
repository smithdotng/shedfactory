<%
  const title = "Content Creation";
  const description = "Shedfactory crafts compelling content that tells your story, engages your audience, and establishes your brand as an industry authority.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-services.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li><a href="/services">Services</a></li>
                <li><span>/</span></li>
                <li>Content Creation</li>
            </ul>
            <h2>Content Creation</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Service Details Start -->
<section class="service-details">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="service-details__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Tell Your Story, Amplify Your Voice</span>
                        <h2 class="section-title__title">Content That Connects and Converts</h2>
                    </div>
                    <p class="service-details__text">In a digital world saturated with noise, great content is how you stand out. It’s the bridge between your brand and your audience—informing, inspiring, and building trust. Our content creation service helps you craft a consistent narrative across every channel, from your website to social media and beyond.</p>
                    <p class="service-details__text">We don’t just write words; we develop content strategies that align with your business goals. Whether you need blog posts, website copy, video scripts, or social media content, our team creates material that resonates with your target audience and drives meaningful engagement.</p>
                    <div class="service-details__points-box">
                        <ul class="list-unstyled service-details__points">
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Content Strategy & Planning</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Copywriting & Blog Posts</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Video Scripts & Storyboarding</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Social Media Content & Management</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <a href="/contact" class="thm-btn service-details__btn">Start Telling Your Story</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="service-details__right">
                    <div class="service-details__img">
                        <img src="/assets/images/services/content-creation.jpg" alt="Content Creation">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service Details End -->

<!-- Process Start -->
<section class="process-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Our Approach</span>
            <h2 class="section-title__title">How We Craft Your Content</h2>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                <div class="process-one__single">
                    <div class="process-one__count">01</div>
                    <div class="process-one__content">
                        <h3>Discovery & Strategy</h3>
                        <p>We dive into your brand, audience, and goals to create a tailored content plan.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="process-one__single">
                    <div class="process-one__count">02</div>
                    <div class="process-one__content">
                        <h3>Creation & Collaboration</h3>
                        <p>Our writers, designers, and videographers produce high‑quality, engaging content.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                <div class="process-one__single">
                    <div class="process-one__count">03</div>
                    <div class="process-one__content">
                        <h3>Optimisation & SEO</h3>
                        <p>We ensure your content is discoverable and drives organic traffic.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                <div class="process-one__single">
                    <div class="process-one__count">04</div>
                    <div class="process-one__content">
                        <h3>Distribution & Analysis</h3>
                        <p>We share your content across channels and refine based on performance.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process End -->

<!-- Why It Matters Start -->
<section class="we-shape" style="margin-top: 0;">
    <div class="we-shape-bg" style="background-image: url(/assets/images/backgrounds/why-choose-us.jpg)"></div>
    <div class="container">
        <div class="we-shape__top">
            <div class="row">
                <div class="col-xl-7">
                    <div class="we-shape__top-title">
                        <h2>Why Great Content Matters</h2>
                        <a href="/contact" class="we-shape__top-btn thm-btn">Let’s Talk</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="we-shape__bottom">
            <div class="row">
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="300ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-engagement"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Builds Authority</h4>
                            <p>Valuable content positions you as a trusted expert in your industry.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="600ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-engagement"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Drives Engagement</h4>
                            <p>Compelling stories and information keep your audience coming back.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="900ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-roi"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Boosts SEO</h4>
                            <p>Fresh, relevant content improves search rankings and organic reach.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Why It Matters End -->

<!-- Testimonial Start -->
<section class="inspire about-page-inspire">
    <div class="inspire__container">
        <div class="inspire-bg jarallax" data-jarallax data-speed="0.2" data-imgPosition="50% 0%"
            style="background-image: url(/assets/images/backgrounds/testimonials-bg.jpg)"></div>
        <div class="inspire-bg-overly"></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="inspire__left">
                        <div class="inspire__carousel owl-theme owl-carousel">
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory has been instrumental in our digital journey. They manage our social media with exceptional strategic communication. Our online presence has grown significantly, and they've helped us connect with our community in meaningful ways."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Ifedi</h4>
                                    <p class="inspire__clinet-title">Radiant Life Day Centre</p>
                                </div>
                            </div>
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"Shedfactory didn't just create our brand identity and website—they built us a complete recruitment portal that streamlines our hiring process. Their strategic approach to our digital presence has been instrumental in Serinity Healthkare's growth."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Maureen, CEO</h4>
                                    <p class="inspire__clinet-title">Serinity Healthkare</p>
                                </div>
                            </div>
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
                                <p class="inspire__text">"The website Shedfactory created for Savoy Summerset Hotel perfectly captures the elegance and luxury of our property. It's visually stunning and has received wonderful feedback from our guests."</p>
                                <div class="inspire__client-info">
                                    <h4 class="inspire__clinet-name">Lanre, Manager</h4>
                                    <p class="inspire__clinet-title">Savoy Summerset Hotel</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Testimonial End -->

<!-- CTA Start -->
<section class="cta-one">
    <div class="container">
        <div class="cta-one__inner">
            <div class="cta-one__left">
                <h2 class="cta-one__title">Ready to share your story with the world?</h2>
                <p class="cta-one__subtitle">Let’s create content that truly represents you.</p>
            </div>
            <div class="cta-one__button">
                <a href="/contact" class="thm-btn cta-one__btn">Start Your Project</a>
            </div>
        </div>
    </div>
</section>
<!-- CTA End -->

<%- include('partials/footer') %>