<%
  const title = "Web & App Development";
  const description = "Shedfactory builds custom websites and applications that deliver exceptional user experiences and drive business growth.";
%>
<%- include('partials/header', { title, description, currentPath }) %>

<!-- Sticky Header -->
<div class="stricky-header stricked-menu main-menu">
    <div class="sticky-header__content"></div>
</div>

<!-- Page Header Start -->
<section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg-services.jpg);">
    <div class="container">
        <div class="page-header__inner">
            <ul class="thm-breadcrumb list-unstyled">
                <li><a href="/">Home</a></li>
                <li><span>/</span></li>
                <li><a href="/services">Services</a></li>
                <li><span>/</span></li>
                <li>Web & App Development</li>
            </ul>
            <h2>Web & App Development</h2>
        </div>
    </div>
</section>
<!-- Page Header End -->

<!-- Service Details Start -->
<section class="service-details">
    <div class="container">
        <div class="row">
            <div class="col-xl-6">
                <div class="service-details__left">
                    <div class="section-title text-left">
                        <span class="section-title__tagline">Build Digital Experiences That Perform</span>
                        <h2 class="section-title__title">Turn Your Vision Into a Powerful Digital Product</h2>
                    </div>
                    <p class="service-details__text">Your website or application is often the first interaction customers have with your brand. It needs to be fast, intuitive, and beautiful—a true reflection of your dream. We build custom digital solutions that engage users, drive conversions, and scale with your business.</p>
                    <p class="service-details__text">From simple brochure sites to complex web applications and e‑commerce platforms, we use modern technologies and proven methodologies to deliver reliable, high‑performance results. We also develop mobile apps for iOS and Android, ensuring a seamless experience across all devices.</p>
                    <div class="service-details__points-box">
                        <ul class="list-unstyled service-details__points">
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Custom Website Design & Development</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>E‑commerce Solutions (Shopify, WooCommerce, Custom)</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Mobile App Development (iOS & Android)</p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <i class="fa fa-check"></i>
                                </div>
                                <div class="text">
                                    <p>Content Management Systems & Portals</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <a href="/contact" class="thm-btn service-details__btn">Start Your Project</a>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="service-details__right">
                    <div class="service-details__img">
                        <img src="/assets/images/services/web-development.jpg" alt="Web & App Development">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Service Details End -->

<!-- Process Start -->
<section class="process-one">
    <div class="container">
        <div class="section-title text-center">
            <span class="section-title__tagline">Our Approach</span>
            <h2 class="section-title__title">How We Build Your Digital Product</h2>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                <div class="process-one__single">
                    <div class="process-one__count">01</div>
                    <div class="process-one__content">
                        <h3>Discovery & Planning</h3>
                        <p>We dive into your goals, users, and requirements to create a clear roadmap.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="process-one__single">
                    <div class="process-one__count">02</div>
                    <div class="process-one__content">
                        <h3>Design & Prototyping</h3>
                        <p>We craft intuitive user interfaces and interactive prototypes for feedback.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                <div class="process-one__single">
                    <div class="process-one__count">03</div>
                    <div class="process-one__content">
                        <h3>Development & Testing</h3>
                        <p>Our developers build using modern frameworks, with continuous testing.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                <div class="process-one__single">
                    <div class="process-one__count">04</div>
                    <div class="process-one__content">
                        <h3>Launch & Support</h3>
                        <p>We deploy your product and provide ongoing maintenance and optimization.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Process End -->

<!-- Why It Matters Start -->
<section class="we-shape" style="margin-top: 0;">
    <div class="we-shape-bg" style="background-image: url(/assets/images/backgrounds/why-choose-us.jpg)"></div>
    <div class="container">
        <div class="we-shape__top">
            <div class="row">
                <div class="col-xl-7">
                    <div class="we-shape__top-title">
                        <h2>Why Great Development Matters</h2>
                        <a href="/contact" class="we-shape__top-btn thm-btn">Let’s Talk</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="we-shape__bottom">
            <div class="row">
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="300ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-speed"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Speed & Performance</h4>
                            <p>Fast‑loading sites improve user experience and search engine rankings.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="600ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-engagement"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>User Engagement</h4>
                            <p>Intuitive design keeps visitors on your site and converts them into customers.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 wow fadeInLeft" data-wow-delay="900ms">
                    <div class="we-shape__single">
                        <div class="we-shape__icon">
                            <span class="icon-scale"></span>
                        </div>
                        <div class="we-shape__content">
                            <h4>Scalability</h4>
                            <p>Built to grow with your business, handling increased traffic and features.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Why It Matters End -->

<!-- Testimonial Start -->
