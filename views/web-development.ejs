        <div class="inspire-bg-overly"></div>
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="inspire__left">
                        <div class="inspire__carousel owl-theme owl-carousel">
                            <div class="inspire__single">
                                <div class="inspire__quote">
                                    <span class="icon-quote"></span>
                                </div>
