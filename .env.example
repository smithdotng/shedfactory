# MongoDB connection (same database as the old Express site)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/shedfactory
# Admin dashboard at /admin (basic auth). Both are required — admin is locked if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Public site URL, used for metadata
NEXT_PUBLIC_SITE_URL=https://shedfactory.co
